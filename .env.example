# ─────────────────────────────────────────────────────────────
# DATABASE — connection is composed from these parts by
# src/server/db/connection.ts (also used by prisma.config.ts for CLI).
# Alternatively set a single DATABASE_URL to override everything.
# ─────────────────────────────────────────────────────────────
DATABASE_HOST="localhost"
DATABASE_PORT="5432"
DATABASE_NAME="club_management"
DATABASE_USER="club"
DATABASE_PASSWORD=""
NEXT_PUBLIC_APP_NAME="Cue Club Admin"

# ─────────────────────────────────────────────────────────────
# INTEGRATIONS (all disabled by default until keys are added)
# ─────────────────────────────────────────────────────────────

# Razorpay — advance payments for online bookings
# 1. Create account & payments keys at https://dashboard.razorpay.com
# 2. Key ID + Key Secret: Dashboard → Settings → API Keys → Generate
# 3. Webhook secret: Dashboard → Settings → Webhooks → Add Webhook
#    URL: https://<your-domain>/api/integrations/razorpay/webhook
#    Events: payment_link.paid
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Stripe — advance payments for online bookings
# 1. Create account at https://dashboard.stripe.com
# 2. Secret key: Developers → API Keys (sk_test_... / sk_live_...)
# 3. Webhook: Developers → Webhooks → Add endpoint
#    URL: https://<your-domain>/api/integrations/stripe/webhook
#    Event: checkout.session.completed
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# WhatsApp — customer booking confirmations & cancellations
# Generic gateway endpoint that accepts POST JSON:
# { "messaging_product": "whatsapp", "to": "...", "type": "text", "text": { "body": "..." } }
# Compatible gateways: WhatsApp Business Cloud API (Graph API),
# Twilio, WATI, AiSensy, Interakt, or any custom gateway with the same shape.
WHATSAPP_API_URL=""
WHATSAPP_API_TOKEN=""
WHATSAPP_FROM=""

# Public base URL used for payment success/cancel redirects & QR links
# APP_BASE_URL="app.yourdomain.com"

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────
# REQUIRED in production. Generate with: openssl rand -hex 32
# Session tokens are HMAC-signed with this. Missing => app refuses to start.
AUTH_SECRET=""

# Access key for the /magic-login one-click dev login.
# Local dev default: "local-dev-key" (no env needed). In production magic login
# stays disabled unless MAGIC_LOGIN_ENABLED=true AND this key is set.
DEV_ACCESS_KEY=""
# Set to "true" ONLY if you intentionally want magic login in production.
MAGIC_LOGIN_ENABLED=""

# Public /docs handbook viewer. Locked (404) in production unless set to "true".
DOCS_ENABLED=""
